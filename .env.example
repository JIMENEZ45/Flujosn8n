# Copia este archivo como .env.local y completa los valores.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Webhooks de produccion de n8n (si quedan vacios, el flujo responde en modo demo)
N8N_WEBHOOK_AUT_TESTS=
N8N_WEBHOOK_DESCARGAR_RECURSOS=
N8N_WEBHOOK_MATRIZ_CSV=
N8N_WEBHOOK_PLANTILLAS=

# Opcional: misma clave del Header Auth configurado en n8n
N8N_SHARED_SECRET=
